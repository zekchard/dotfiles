color-link default "#eee0d5"
color-link comment "#9d8e81"
color-link selection "#492900,#fbba74"
color-link hlsearch "#e1c1a3"

color-link identifier "#fbba74"
color-link identifier.class "#fbba74"
color-link identifier.var "#fbba74"

color-link constant "#becc9b"
color-link constant.number "#becc9b"
color-link constant.string "#e1c1a3"

color-link symbol "#becc9b"
color-link symbol.brackets "#d5c3b5"
color-link symbol.tag "#fbba74"

color-link type "#fbba74"
color-link type.keyword "#e1c1a3"

color-link special "#becc9b"
color-link statement "#e1c1a3"
color-link preproc "#becc9b"

color-link underlined "#e1c1a3"
color-link error "bold #ffb4ab"
color-link todo "bold #becc9b"

color-link diff-added "#e1c1a3"
color-link diff-modified "#becc9b"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#becc9b"

color-link scrollbar "#d5c3b5"
color-link statusline "#eee0d5,#19120c"
color-link tabbar "#eee0d5,#19120c"
color-link indent-char "#50453a"
color-link line-number "#50453a"
color-link current-line-number "#fbba74"

color-link cursor-line "#50453a,#eee0d5"
color-link color-column "#50453a"
color-link type.extended "default"
