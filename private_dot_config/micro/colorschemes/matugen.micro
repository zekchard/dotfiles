color-link default "#e7e0e8"
color-link comment "#948f99"
color-link selection "#37265c,#d1bcfd"
color-link hlsearch "#ccc2db"

color-link identifier "#d1bcfd"
color-link identifier.class "#d1bcfd"
color-link identifier.var "#d1bcfd"

color-link constant "#f0b8c6"
color-link constant.number "#f0b8c6"
color-link constant.string "#ccc2db"

color-link symbol "#f0b8c6"
color-link symbol.brackets "#cbc4cf"
color-link symbol.tag "#d1bcfd"

color-link type "#d1bcfd"
color-link type.keyword "#ccc2db"

color-link special "#f0b8c6"
color-link statement "#ccc2db"
color-link preproc "#f0b8c6"

color-link underlined "#ccc2db"
color-link error "bold #ffb4ab"
color-link todo "bold #f0b8c6"

color-link diff-added "#ccc2db"
color-link diff-modified "#f0b8c6"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#f0b8c6"

color-link scrollbar "#cbc4cf"
color-link statusline "#e7e0e8,#141218"
color-link tabbar "#e7e0e8,#141218"
color-link indent-char "#49454e"
color-link line-number "#49454e"
color-link current-line-number "#d1bcfd"

color-link cursor-line "#49454e,#e7e0e8"
color-link color-column "#49454e"
color-link type.extended "default"
