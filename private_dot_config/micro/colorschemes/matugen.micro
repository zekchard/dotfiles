color-link default "#e3e2e9"
color-link comment "#8f909a"
color-link selection "#1a2d60,#b4c5ff"
color-link hlsearch "#c1c5dd"

color-link identifier "#b4c5ff"
color-link identifier.class "#b4c5ff"
color-link identifier.var "#b4c5ff"

color-link constant "#e2bbdc"
color-link constant.number "#e2bbdc"
color-link constant.string "#c1c5dd"

color-link symbol "#e2bbdc"
color-link symbol.brackets "#c5c6d0"
color-link symbol.tag "#b4c5ff"

color-link type "#b4c5ff"
color-link type.keyword "#c1c5dd"

color-link special "#e2bbdc"
color-link statement "#c1c5dd"
color-link preproc "#e2bbdc"

color-link underlined "#c1c5dd"
color-link error "bold #ffb4ab"
color-link todo "bold #e2bbdc"

color-link diff-added "#c1c5dd"
color-link diff-modified "#e2bbdc"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#e2bbdc"

color-link scrollbar "#c5c6d0"
color-link statusline "#e3e2e9,#121318"
color-link tabbar "#e3e2e9,#121318"
color-link indent-char "#45464f"
color-link line-number "#45464f"
color-link current-line-number "#b4c5ff"

color-link cursor-line "#45464f,#e3e2e9"
color-link color-column "#45464f"
color-link type.extended "default"
