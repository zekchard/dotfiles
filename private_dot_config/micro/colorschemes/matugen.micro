color-link default "#e4e1e9"
color-link comment "#90909a"
color-link selection "#242b61,#bcc2ff"
color-link hlsearch "#c4c5dd"

color-link identifier "#bcc2ff"
color-link identifier.class "#bcc2ff"
color-link identifier.var "#bcc2ff"

color-link constant "#e6bad7"
color-link constant.number "#e6bad7"
color-link constant.string "#c4c5dd"

color-link symbol "#e6bad7"
color-link symbol.brackets "#c7c5d0"
color-link symbol.tag "#bcc2ff"

color-link type "#bcc2ff"
color-link type.keyword "#c4c5dd"

color-link special "#e6bad7"
color-link statement "#c4c5dd"
color-link preproc "#e6bad7"

color-link underlined "#c4c5dd"
color-link error "bold #ffb4ab"
color-link todo "bold #e6bad7"

color-link diff-added "#c4c5dd"
color-link diff-modified "#e6bad7"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#e6bad7"

color-link scrollbar "#c7c5d0"
color-link statusline "#e4e1e9,#131318"
color-link tabbar "#e4e1e9,#131318"
color-link indent-char "#46464f"
color-link line-number "#46464f"
color-link current-line-number "#bcc2ff"

color-link cursor-line "#46464f,#e4e1e9"
color-link color-column "#46464f"
color-link type.extended "default"
