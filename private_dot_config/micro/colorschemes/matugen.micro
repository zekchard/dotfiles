color-link default "#e3e2e0"
color-link comment "#91918f"
color-link selection "#24342e,#b9cbc3"
color-link hlsearch "#bfc9c4"

color-link identifier "#b9cbc3"
color-link identifier.class "#b9cbc3"
color-link identifier.var "#b9cbc3"

color-link constant "#b2ccc2"
color-link constant.number "#b2ccc2"
color-link constant.string "#bfc9c4"

color-link symbol "#b2ccc2"
color-link symbol.brackets "#c7c6c5"
color-link symbol.tag "#b9cbc3"

color-link type "#b9cbc3"
color-link type.keyword "#bfc9c4"

color-link special "#b2ccc2"
color-link statement "#bfc9c4"
color-link preproc "#b2ccc2"

color-link underlined "#bfc9c4"
color-link error "bold #ffb4ab"
color-link todo "bold #b2ccc2"

color-link diff-added "#bfc9c4"
color-link diff-modified "#b2ccc2"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#b2ccc2"

color-link scrollbar "#c7c6c5"
color-link statusline "#e3e2e0,#121413"
color-link tabbar "#e3e2e0,#121413"
color-link indent-char "#464746"
color-link line-number "#464746"
color-link current-line-number "#b9cbc3"

color-link cursor-line "#464746,#e3e2e0"
color-link color-column "#464746"
color-link type.extended "default"
