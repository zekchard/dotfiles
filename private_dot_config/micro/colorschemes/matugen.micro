color-link default "#e3e2e2"
color-link comment "#919190"
color-link selection "#233335,#b8cacc"
color-link hlsearch "#bec8ca"

color-link identifier "#b8cacc"
color-link identifier.class "#b8cacc"
color-link identifier.var "#b8cacc"

color-link constant "#b1cbcf"
color-link constant.number "#b1cbcf"
color-link constant.string "#bec8ca"

color-link symbol "#b1cbcf"
color-link symbol.brackets "#c7c6c6"
color-link symbol.tag "#b8cacc"

color-link type "#b8cacc"
color-link type.keyword "#bec8ca"

color-link special "#b1cbcf"
color-link statement "#bec8ca"
color-link preproc "#b1cbcf"

color-link underlined "#bec8ca"
color-link error "bold #ffb4ab"
color-link todo "bold #b1cbcf"

color-link diff-added "#bec8ca"
color-link diff-modified "#b1cbcf"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#b1cbcf"

color-link scrollbar "#c7c6c6"
color-link statusline "#e3e2e2,#121414"
color-link tabbar "#e3e2e2,#121414"
color-link indent-char "#464747"
color-link line-number "#464747"
color-link current-line-number "#b8cacc"

color-link cursor-line "#464747,#e3e2e2"
color-link color-column "#464747"
color-link type.extended "default"
